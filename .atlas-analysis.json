{
  "projectType": "sdk-library",
  "projectName": "kkRPC",
  "projectDescription": "A TypeScript-first RPC library for bidirectional, type-safe communication across workers, iframes, stdio, WebSocket, HTTP, desktop runtimes, and message buses.",
  "theme": "luma",
  "primaryColor": "#3d50f5",
  "lightColor": "#040404",
  "darkColor": null,
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
